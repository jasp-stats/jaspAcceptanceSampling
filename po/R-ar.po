msgstr "التخطيط"

msgid "Please ensure 0 < AQL < RQL < 1."
msgstr "يرجى التأكد من أن 0 < AQL < RQL < 1."

msgid "Please provide a valid maximum sample size (> 0)."
msgstr "يرجى تقديم حجم عينة أقصى صالح (> 0)."

