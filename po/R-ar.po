msgstr "PPD رديء (> %1$d عيبًا في الدفعة)"

msgid "Sample Size (n)"
msgstr "حجم العينة (n)"

msgid "Defects (d)"
msgstr "العيوب (d)"

msgid "AQL"
msgstr "AQL"

msgid "RQL"
msgstr "RQL"

msgid "Bayes Factor"
msgstr "عامل بايز"

msgid "Bayes factor interpretation: BF ≥ 10 (strong evidence for H−), 3 ≤ BF < 10 (moderate evidence for H−), 0.33 ≤ BF < 3 (inconclusive), 0.10 ≤ BF < 0.33 (moderate evidence for H+), BF < 0.10 (strong evidence for H+)."
msgstr ""
"تفسير عامل بايز: BF ≥ 10 (دليل قوي لصالح H−)، 3 ≤ BF < 10 (متوسط لصالح H−)، "
"0.33 ≤ BF < 3 (غير حاسم)، 0.10 ≤ BF < 0.33 (متوسط لصالح H+)، BF < 0.10 (قوي "
"لصالح H+)."

msgid "Procedure"
msgstr "الإجراء"

msgid "<div style='line-height: 1.2;'>\n    <p style='margin: 0 0 8px 0;'>The <b>main objective</b> of this Bayesian sampling procedure is to evaluate the quality of a lot by determining if the proportion of defects is lower than the <b>Rejectable Quality Level (RQL)</b>, which is currently set at <b>%1$.2f%%</b>.</p>\n\n    <p style='margin: 0 0 4px 0;'>Two primary statistical hypotheses are formulated about the lot proportion defective (&theta;):</p>\n    <ul style='margin: 0 0 8px 20px;'>\n      <li>The (null) hypothesis of intolerable quality H<sub>+</sub>: &theta; &ge; %1$.2f%% (user-defined)</li>\n      <li>The (alternative) hypothesis of tolerable quality H<sub>-</sub>: &theta; < %1$.2f%% (user-defined)</li>\n    </ul>\n\n    <p style='margin: 0 0 8px 0;'>Additionally, users have the option to perform a <b>Three-Hypothesis Test</b>, which partitions the quality levels into 'Good' (&le; AQL), 'Middle' (AQL < &theta; &le; RQL), and 'Bad' (> RQL) regions.</p>\n\n    <p style='margin: 0 0 8px 0;'>The <b>Acceptable Quality Level (AQL)</b> is currently set at <b>%2$.2f%%</b>. This value represents the\n    quality level aimed for acceptance with high probability. These quality constraints can be adjusted in the Planning phase to reflect specific requirements.</p>\n\n    <p style='margin: 0 0 6px 0;'><b>Stages</b></p>\n    <p style='margin: 0 0 6px 0;'><b>1. Planning:</b> Determine a minimum sample size such that the sample provides sufficient evidence (a target Bayes factor) to achieve the specified sampling objectives.</p>\n\n    <p style='margin: 0;'><b>2. Inference:</b> Evaluate observed data to update the prior belief into\n    a posterior distribution. In this section, <b>n</b> denotes the sample size, <b>d</b> the observed number of defects in the sample, and <b>N</b> the lot size.</p></div>"
msgstr ""
"<div style='line-height: 1.2;'>\n"
"    <p style='margin: 0 0 8px 0;'><b>الهدف الأساسي</b> لإجراء المعاينة "
"البايزية هذا تقييم جودة الدفعة بتحديد ما إذا كانت نسبة العيوب أدنى من <b>"
"مستوى الجودة المرفوض (RQL)</b>، المحدد حاليًا عند <b>%1$.2f%%</b>.</p>\n"
"\n"
"    <p style='margin: 0 0 4px 0;'>تُصاغ فرضيتان إحصائيتان أساسيتان عن نسبة "
"العيوب في الدفعة (&theta;):</p>\n"
"    <ul style='margin: 0 0 8px 20px;'>\n"
"      <li>الفرضية (الصفرية) للجودة غير الممكن تحملها H<sub>+</sub>: &theta; "
"&ge; %1$.2f%% (يحددها المستخدم)</li>\n"
"      <li>الفرضية (البديلة) للجودة الممكن تحملها H<sub>-</sub>: &theta; < "
"%1$.2f%% (يحددها المستخدم)</li>\n"
"    </ul>\n"
"\n"
"    <p style='margin: 0 0 8px 0;'>يمكن أيضًا إجراء <b>اختبار ثلاث فرضيات</b>، "
"يقسم مستويات الجودة إلى مناطق «جيد» (&le; AQL)، و«متوسط» (AQL < &theta; &le; "
"RQL)، و«رديء» (> RQL).</p>\n"
"\n"
"    <p style='margin: 0 0 8px 0;'>حُدد <b>مستوى الجودة المقبول (AQL)</b> "
"حاليًا عند <b>%2$.2f%%</b>. يمثل مستوى الجودة المراد قبوله باحتمال مرتفع. "
"يمكن تعديل قيود الجودة في مرحلة التخطيط لتعكس المتطلبات المحددة.</p>\n"
"\n"
"    <p style='margin: 0 0 6px 0;'><b>المراحل</b></p>\n"
"    <p style='margin: 0 0 6px 0;'><b>1. التخطيط:</b> تحديد أدنى حجم عينة "
"يوفر دليلًا كافيًا (عامل بايز مستهدفًا) لتحقيق أهداف المعاينة المحددة.</p>\n"
"\n"
"    <p style='margin: 0;'><b>2. الاستدلال:</b> تقييم البيانات المشاهَدة لتحديث "
"الاعتقاد القبلي إلى توزيع بعدي. يمثل <b>n</b> حجم العينة، و<b>d</b> عدد "
"العيوب المشاهَدة فيها، و<b>N</b> حجم الدفعة.</p></div>"

msgid "Lower limit for proportion non-conforming items needs to be smaller than the upper limit."
msgstr "يجب أن يكون الحد الأدنى لنسبة البنود غير المطابقة أصغر من الحد الأعلى."

msgid "Step size for proportion non-conforming items needs to be smaller than the difference between the upper and lower limits."
msgstr ""
"يجب أن تكون خطوة نسبة البنود غير المطابقة أصغر من الفرق بين الحدين الأعلى "
"والأدنى."

msgid "Step size of 0 is allowed only if the lower and upper limits of proportion non-conforming items are identical."
msgstr ""
"تُسمح خطوة قدرها 0 فقط عند تطابق الحدين الأدنى والأعلى لنسبة البنود غير "
"المطابقة."

msgid "For hypergeometric distribution, N * proportion non-conforming should all be integer values.\n\nCheck the values of N and proportion non-conforming."
msgstr ""
"في التوزيع فوق الهندسي، يجب أن تكون جميع قيم N * نسبة البنود غير المطابقة "
"أعدادًا صحيحة.\n"
"\n"
"تحقق من قيم N ونسبة البنود غير المطابقة."

msgid "Sample size (n) cannot be larger than the lot size (N)."
msgstr "لا يمكن أن يتجاوز حجم العينة (n) حجم الدفعة (N)."

msgid "Acceptance number (c) cannot be larger than the sample size (n)."
msgstr "لا يمكن أن يتجاوز عدد القبول (c) حجم العينة (n)."

msgid "Rejection number (r) cannot be larger than the sample size (n)."
msgstr "لا يمكن أن يتجاوز عدد الرفض (r) حجم العينة (n)."

msgid "Rejection number (r) has to be larger than the acceptance number (c)."
msgstr "يجب أن يكون عدد الرفض (r) أكبر من عدد القبول (c)."

msgid "Cumulative sample size (n1+n2+...) cannot be larger than the lot size (N)."
msgstr "لا يمكن أن يتجاوز حجم العينة التراكمي (n1+n2+...) حجم الدفعة (N)."

msgid "Final rejection number (r) needs to be 1 more than the final acceptance number (c)."
msgstr "يجب أن يزيد عدد الرفض النهائي (r) على عدد القبول النهائي (c) بمقدار 1."

msgid "Rejection number (r) for every stage has to be larger than the corresponding acceptance number (c)."
msgstr "يجب أن يكون عدد الرفض (r) لكل مرحلة أكبر من عدد القبول (c) المقابل."

msgid "For all stages except the last stage, rejection numbers (r) have to be at at least 2 greater than the acceptance numbers (c).\n\n                                   Else, subsequent stages become redundant."
msgstr ""
"في جميع المراحل عدا الأخيرة، يجب أن تتجاوز أعداد الرفض (r) أعداد القبول (c) "
"بمقدار 2 على الأقل.\n"
"\n"
"                                   وإلا أصبحت المراحل اللاحقة زائدة عن الحاجة."

msgid "Acceptance numbers (c) are cumulative, so they need to be in a non-decreasing sequence."
msgstr "أعداد القبول (c) تراكمية، لذا يجب أن تشكّل متتالية غير متناقصة."

msgid "Rejection numbers (r) are cumulative, so they need to be in a non-decreasing sequence."
msgstr "أعداد الرفض (r) تراكمية، لذا يجب أن تشكل متتالية غير متناقصة."

msgid "No valid values found in the plan. Check the inputs."
msgstr "لا توجد قيم صالحة في الخطة. افحص المدخلات."

msgid "AQL (Acceptable Quality Level) value should be lower than RQL (Rejectable Quality Level) value."
msgstr ""
"يجب أن تكون قيمة AQL (مستوى الجودة المقبول) أصغر من قيمة RQL (مستوى الجودة "
"المرفوض)."

msgid "1 - α (Producer's risk) has to be greater than β (consumer's risk)."
msgstr "يجب أن يكون 1 - α (مخاطر المُنتِج) أكبر من β (مخاطر المستهلك)."

msgid "Current plan <b>CAN %s</b> meet the specified risk point(s)."
msgstr "حالة استيفاء خطة المعاينة الحالية لنقاط المخاطر المحددة: <b>CAN %s</b>."

msgid "Proportion Non-conforming"
msgstr "نسبة عدم المطابقة"

msgid "Required P(accept)"
msgstr "قيمة P(accept) المطلوبة"

msgid "Actual P(accept)"
msgstr "احتمال القبول الفعلي P(accept)"

msgid "Probability of acceptance (%1$.3f) at AQL (%2$.3f) is <b>lower</b> than the required probability of acceptance (%3$.3f) at AQL."
msgstr ""
"احتمال القبول (%1$.3f) عند AQL (%2$.3f) <b>أقل</b> من احتمال القبول المطلوب "
"(%3$.3f) عند AQL."

msgid "Probability of acceptance (%1$.3f) at RQL (%2$.3f) is <b>higher</b> than the required probability of acceptance (%3$.3f) at RQL."
msgstr ""
"احتمال القبول (%1$.3f) عند RQL (%2$.3f) <b>أعلى</b> من احتمال القبول المطلوب "
"(%3$.3f) عند RQL."

msgid "Acceptance Probabilities"
msgstr "احتمالات القبول"

msgid "Prop. Non-conforming"
msgstr "نسبة عدم المطابقة"

msgid "P(accept)"
msgstr "P(accept)"

msgid "OC (Operating Characteristics) Curve"
msgstr "منحنى خصائص التشغيل (OC)"

msgid "Probability of Acceptance"
msgstr "احتمال القبول"

msgid "AOQ (Average Outgoing Quality) Curve"
msgstr "منحنى متوسط جودة المخرجات (AOQ)"

msgid "Can not calculate AOQ. Check the plan parameters."
msgstr "تعذّر حساب AOQ. تحقق من معلمات الخطة."

msgid "(Incoming) Proportion Non-conforming"
msgstr "نسبة الوحدات الواردة غير المطابقة"

msgid "Average Outgoing Quality"
msgstr "متوسط جودة المخرجات"

msgid "AOQL: %.3f"
msgstr "AOQL: %.3f"

msgid "ATI (Average Total Inspection) Curve"
msgstr "منحنى متوسط إجمالي الوحدات المفحوصة (ATI)"

msgid "Can not calculate ATI. Check the plan parameters."
msgstr "تعذّر حساب ATI. تحقق من معلمات الخطة."

msgid "Average Total Inspection"
msgstr "متوسط إجمالي الوحدات المفحوصة"

msgid "ASN (Average Sample Number) Curve"
msgstr "منحنى متوسط حجم العينة (ASN)"

msgid "Can not calculate ASN. Check the plan parameters."
msgstr "تعذّر حساب ASN. تحقق من معلمات الخطة."

msgid "Average Sample Number"
msgstr "متوسط حجم العينة"

msgid "Generated Sampling Plan"
msgstr "خطة المعاينة المولّدة"

msgid "Acceptance probabilities at AQL and RQL"
msgstr "احتمالات القبول عند AQL وRQL"

msgid "Acceptance Probability"
msgstr "احتمال القبول"

msgid "Rejection Probability"
msgstr "احتمال الرفض"

msgid "If the number of defective items out of %1$d sampled is <= %2$d, accept the lot. Reject otherwise."
msgstr ""
"إذا كان عدد البنود المعيبة من أصل %1$d بندًا في العينة <= %2$d، فاقبل الدفعة. "
"وإلا فارفضها."

msgid "Create Variable Plan"
msgstr "إنشاء خطة المعاينة بالمتغيرات"

msgid "Z.LSL = (mean - LSL) / historical standard deviation\n\nAccept lot if Z.LSL >= k, otherwise reject."
msgstr ""
"Z.LSL = (mean - LSL) / الانحراف المعياري التاريخي\n"
"\n"
"تُقبل الدفعة إذا كان Z.LSL >= k، وإلا تُرفض."

msgid "Variable plan generated for the current quality constraints is invalid. Modify the quality constraints."
msgstr ""
"خطة المعاينة بالمتغيرات المولّدة لقيود الجودة الحالية غير صالحة. عدّل قيود "
"الجودة."

msgid "Variable plan generated for the current quality constraints has an invalid sample size (n). Modify the quality constraints."
msgstr ""
"حجم العينة (n) في خطة المعاينة بالمتغيرات المولّدة لقيود الجودة الحالية غير "
"صالح. عدّل قيود الجودة."

msgid "Variable plan generated for the current quality constraints has an invalid k value. Modify the quality constraints."
msgstr ""
"قيمة k في خطة المعاينة بالمتغيرات المولّدة لقيود الجودة الحالية غير صالحة. "
"عدّل قيود الجودة."

msgid "Accept or Reject Lot %s"
msgstr "قبول أو رفض الدفعة %s"

msgid "Sample Mean"
msgstr "متوسط العينة"

msgid "Sample Standard Deviation"
msgstr "الانحراف المعياري للعينة"

msgid "Historical Standard Deviation"
msgstr "الانحراف المعياري التاريخي"

msgid "Lower Specification Limit (LSL)"
msgstr "الحد الأدنى للمواصفات (LSL)"

msgid "Upper Specification Limit (USL)"
msgstr "حد المواصفات الأعلى (USL)"

msgid "Z.LSL"
msgstr "Z.LSL"

msgid "Z.USL"
msgstr "Z.USL"

msgid "Sample standard deviation has to be greater than 0."
msgstr "يجب أن يكون الانحراف المعياري للعينة أكبر من 0."

msgid "Sample mean is invalid."
msgstr "متوسط العينة غير صالح."

msgid "Can not accept or reject lot: sample size has to be greater than 1."
msgstr "يتعذّر قبول الدفعة أو رفضها: يجب أن يكون حجم العينة أكبر من 1."

msgid "Sample size has to be <b>> 1</b> if <b>both</b> LSL and USL are provided, and historical standard deviation is <b>unknown</b>."
msgstr ""
"يجب أن يكون حجم العينة <b>> 1</b> عند تقديم <b>كلا</b> الحدين LSL وUSL مع كون "
"الانحراف المعياري التاريخي <b>غير معلوم</b>."

msgid "<u>Decision:</u> <b>%s</b> lot."
msgstr "<u>القرار:</u> <b>%s</b> الدفعة."
