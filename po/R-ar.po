msgstr "عامل بايز"

msgid "Three-Hypothesis Bayes Factors (at d = c)"
msgstr "عوامل بايز للفرضيات الثلاث (عند d = c)"

msgid "Prior P(Good)"
msgstr "قبلي P(Good)"

msgid "Post P(Good)"
msgstr "بعدي: P(Good)"

msgid "Prior P(Middle)"
msgstr "قبلي P(Middle)"

msgid "Post P(Middle)"
msgstr "بعدي: P(Middle)"

msgid "Prior P(Bad)"
msgstr "قبلي P(Bad)"

msgid "Post P(Bad)"
msgstr "بعدي: P(Bad)"

msgid "BF (Good vs Bad)"
msgstr "عامل بايز (جيد مقابل سيئ)"

msgid "BF (Good vs Middle)"
msgstr "عامل بايز (جيد مقابل متوسط)"

msgid "BF (Middle vs Bad)"
msgstr "عامل بايز (متوسط مقابل سيئ)"

msgid "Posterior Distribution"
msgstr "التوزيع البعدي"

msgid "Prior Distribution"
msgstr "التوزيع القبلي"

msgid "Lot Proportion Defective"
msgstr "نسبة الوحدات المعيبة في الدفعة"

msgid "Posterior Predictive Distribution"
msgstr "التوزيع التنبؤي البعدي"

msgid "Total Defects in Lot"
msgstr "إجمالي العيوب في الدفعة"

msgid "Probability"
msgstr "الاحتمال"

msgid "Inference Decision Table"
msgstr "جدول قرار الاستدلال"

msgid "PPD Good (≤ %1$d defects in Lot)"
msgstr "PPD جيد (≤ %1$d عيبًا في الدفعة)"

msgid "PPD Middle (> %1$d & ≤ %2$d defects)"
msgstr "PPD متوسط (> %1$d و≤ %2$d من العيوب)"

