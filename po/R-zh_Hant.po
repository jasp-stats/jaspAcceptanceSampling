msgstr "無法計算 AOQ。請檢查方案參數。"

msgid "(Incoming) Proportion Non-conforming"
msgstr "（進廠）不良品比例"

msgid "Average Outgoing Quality"
msgstr "平均出廠品質"

msgid "AOQL: %.3f"
msgstr "AOQL：%.3f"

