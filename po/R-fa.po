msgstr "طرح نمونه‌گیری تولیدشده"

msgid "Acceptance probabilities at AQL and RQL"
msgstr "احتمال‌های پذیرش در AQL و RQL"

msgid "Acceptance Probability"
msgstr "احتمال پذیرش"

msgid "Rejection Probability"
msgstr "احتمال رد"

msgid "If the number of defective items out of %1$d sampled is <= %2$d, accept the lot. Reject otherwise."
msgstr ""
"اگر تعداد اقلام معیوب از بین %1$d نمونه‌برداری‌شده <= %2$d باشد، محموله را "
"بپذیرید. در غیر این صورت رد کنید."

msgid "Create Variable Plan"
msgstr "ایجاد طرح متغیر"

msgid "Z.LSL = (mean - LSL) / historical standard deviation\n\nAccept lot if Z.LSL >= k, otherwise reject."
msgstr ""
"Z.LSL = (میانگین - LSL) / انحراف معیار تاریخی\n"
"\n"
"اگر Z.LSL ≥ k باشد، محموله پذیرفته شود؛ در غیر این صورت، رد شود."

msgid "Variable plan generated for the current quality constraints is invalid. Modify the quality constraints."
msgstr ""
"طرح متغیر تولیدشده برای محدودیت‌های کیفی فعلی نامعتبر است. محدودیت‌های کیفی را "
"اصلاح کنید."

msgid "Variable plan generated for the current quality constraints has an invalid sample size (n). Modify the quality constraints."
msgstr ""
"طرح متغیر تولیدشده برای محدودیت‌های کیفی فعلی دارای اندازه نمونه (n) نامعتبر "
"است. محدودیت‌های کیفی را اصلاح کنید."

msgid "Variable plan generated for the current quality constraints has an invalid k value. Modify the quality constraints."
msgstr ""
"طرح متغیر تولیدشده برای محدودیت‌های کیفی فعلی دارای مقدار k نامعتبر است. "
"محدودیت‌های کیفی را اصلاح کنید."

msgid "Accept or Reject Lot %s"
msgstr "پذیرش یا رد محموله %s"

msgid "Sample Mean"
msgstr "میانگین نمونه"

msgid "Sample Standard Deviation"
msgstr "انحراف معیار نمونه"

msgid "Historical Standard Deviation"
msgstr "انحراف معیار تاریخی"

msgid "Lower Specification Limit (LSL)"
msgstr "حد مشخصات پایین (LSL)"

msgid "Upper Specification Limit (USL)"
msgstr "حد مشخصات بالا (USL)"

msgid "Z.LSL"
msgstr "Z.LSL"

msgid "Z.USL"
msgstr "Z.USL"

msgid "Sample standard deviation has to be greater than 0."
msgstr "انحراف معیار نمونه باید بزرگ‌تر از 0 باشد."

msgid "Sample mean is invalid."
msgstr "میانگین نمونه نامعتبر است."

msgid "Can not accept or reject lot: sample size has to be greater than 1."
msgstr ""
"نمی‌توان محموله را پذیرفت یا رد کرد: اندازه نمونه باید بزرگ‌تر از 1 باشد."

msgid "Sample size has to be <b>> 1</b> if <b>both</b> LSL and USL are provided, and historical standard deviation is <b>unknown</b>."
msgstr ""
"اندازه نمونه باید <b>> 1</b> باشد اگر <b>هر دو</b> LSL و USL ارائه شده باشند "
"و انحراف معیار تاریخی <b>نامشخص</b> باشد."

msgid "<u>Decision:</u> <b>%s</b> lot."
msgstr "<u>تصمیم:</u> <b>%s</b> محموله."
