msgid "If historical standard deviation is unknown, sample size has to be > 1."
msgstr ""
"اگر انحراف معیار تاریخی نامشخص باشد، اندازه نمونه باید بزرگ‌تر از ۱ باشد."

msgid "Lot size (N = %1$.0f) cannot be smaller than the sample size (n = %2$.0f) of the generated variable plan."
msgstr ""
"اندازه محموله (N = %1$.0f) نمی‌تواند کوچک‌تر از اندازه نمونه (n = %2$.0f) در "
"طرح متغیر تولید شده باشد."

msgid "The dataset is empty."
msgstr "مجموعه داده خالی است."

msgid "The following assigned variables are missing from the dataset: %1$s."
msgstr "متغیرهای اختصاص‌یافته زیر در مجموعه داده وجود ندارند: %1$s."

msgid "%1$s cannot contain missing or non-finite values."
msgstr "%1$s نمی‌تواند شامل مقادیر گمشده یا نامتناهی باشد."

msgid "%1$s must contain whole numbers only."
msgstr "%1$s باید فقط شامل اعداد صحیح باشد."

msgid "%1$s cannot contain negative values."
msgstr "%1$s نمی‌تواند شامل مقادیر منفی باشد."

msgid "Defect Count"
msgstr "تعداد نقص"

msgid "Lot Size"
msgstr "اندازه محموله"

msgid "Time"
msgstr "زمان"

msgid "Predictor"
msgstr "پیش‌بین"

msgid "Predictor must vary across lots when using the predictor model."
msgstr "هنگام استفاده از مدل پیش‌بین، پیش‌بین باید در بین دسته‌ها تغییر کند."

msgid "Observed defects cannot exceed the sample size for any lot."
msgstr ""
"نقص‌های مشاهده‌شده نمی‌توانند برای هیچ محموله‌ای از اندازه نمونه فراتر روند."

msgid "Sample size cannot exceed the lot size for any lot."
msgstr "اندازه نمونه نمی‌تواند برای هیچ محموله‌ای از اندازه محموله فراتر رود."

msgid "Sampling..."
msgstr "نمونه‌گیری..."

