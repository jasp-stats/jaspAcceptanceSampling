msgstr "نمی‌توان AOQ را محاسبه کرد. پارامترهای طرح را بررسی کنید."

msgid "(Incoming) Proportion Non-conforming"
msgstr "نسبت نامنطبق (ورودی)"

msgid "Average Outgoing Quality"
msgstr "کیفیت خروجی متوسط"

#, fuzzy
msgid "AOQL: %.3f"
msgstr "AOQL: %.3f"

